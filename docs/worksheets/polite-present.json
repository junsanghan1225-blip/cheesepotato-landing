          "먹다",
          "먹-",
          "먹어요",
          "to eat"
        ],
        [
          "읽다",
          "읽-",
          "읽어요",
          "to read"
        ],
        [
          "있다",
          "있-",
          "있어요",
          "to exist / to have"
        ],
        [
          "없다",
          "없-",
          "없어요",
          "to not exist / to not have"
        ],
        [
          "마시다",
          "마시-",
          "마셔요",
          "to drink (시 + 어요 → 셔요)"
        ],
        [
          "주다",
          "주-",
          "줘요",
          "to give (주 + 어요 → 줘요)"
        ],
        [
          "배우다",
          "배우-",
          "배워요",
          "to learn (우 + 어요 → 워요)"
        ],
        [
          "기다리다",
          "기다리-",
          "기다려요",
          "to wait (리 + 어요 → 려요)"
        ]
      ],
      "note": "The 어 merges with a vowel-ending stem too: 시 → 셔, 주 → 줘, 우 → 워, 리 → 려."
    },
    {
      "type": "table",
