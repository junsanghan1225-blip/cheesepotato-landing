    "title": {
      "ko": "-아/어서 vs -(으)니까",
      "en": "-아/어서 vs -(으)니까"
    },
    "gist": {
      "ko": "둘 다 이유를 말해요. 뒤에 명령 · 권유가 오면 「-(으)니까」만 써요.",
      "en": "Both give a reason. If a command or suggestion follows, only -(으)니까 works."
    },
    "diff": [
      {
        "ko": "「-아/어서」 뒤에는 「-(으)세요 · -(으)ㅂ시다 · -(으)ㄹ까요?」가 올 수 없어요.",
        "en": "-아/어서 cannot be followed by -(으)세요, -(으)ㅂ시다 or -(으)ㄹ까요?."
      },
      {
        "ko": "「-아/어서」 앞에는 과거 「-았/었-」을 쓰지 않아요. 「늦었어서」가 아니라 「늦어서」예요.",
        "en": "No past -았/었- before -아/어서: 늦어서, not 늦었어서."
      },
      {
        "ko": "「반갑다 · 고맙다 · 죄송하다」 같은 인사는 「-아/어서」를 써요.",
        "en": "Set greetings like 만나서 반가워요 use -아/어서."
      }
    ],
    "ex": {
      "a": "길이 막혀서 늦었어요.",
      "b": "비가 오니까 우산을 가져가세요."
    },
    "quiz": [
      {
        "q": "비가 ___ 우산을 가져가세요.",
        "ok": "오니까",
        "ans": "b",
        "why": "뒤가 「가져가세요」(명령)라서 「-(으)니까」를 써요."
      },
      {
        "q": "___ 반가워요. (만나다)",
        "ok": "만나서",
        "ans": "a",
        "why": "「만나서 반가워요」는 굳어진 인사예요. 「만나니까 반가워요」라고 하지 않아요."
      },
      {
        "q": "시간이 ___ 택시를 탑시다.",
        "ok": "없으니까",
        "ans": "b",
        "why": "뒤가 「탑시다」(권유)라서 「-(으)니까」만 돼요."
      },
      {
        "q": "늦___ 죄송합니다.",
        "ok": "어서",
        "ans": "a",
        "why": "사과 · 감사 인사는 「-아/어서」로 이유를 말해요."
      },
      {
        "q": "날씨가 ___ 같이 산책할까요?",
        "ok": "좋으니까",
        "ans": "b",
        "why": "뒤가 「-(으)ㄹ까요?」(권유)라서 「-(으)니까」를 써요."
      }
    ]
  },
  {
    "id": "goitda-aeoitda",
    "a": "24-5",
    "b": "42-2",
    "title": {
      "ko": "-고 있다 vs -아/어 있다",
      "en": "-고 있다 vs -아/어 있다"
    },
    "gist": {
      "ko": "「-고 있다」는 하고 있는 중, 「-아/어 있다」는 그렇게 된 채로 있는 상태예요.",
      "en": "-고 있다 = an action in progress; -아/어 있다 = a state that stays after something happened."
    },
    "diff": [
      {
        "ko": "「먹다 · 읽다 · 기다리다」처럼 무엇을 하는 동작은 「-고 있다」를 써요.",
        "en": "Actions like 먹다, 읽다, 기다리다 take -고 있다."
      },
      {
        "ko": "「열리다 · 앉다 · 걸리다」처럼 그렇게 된 뒤 그대로인 것은 「-아/어 있다」를 써요.",
        "en": "Change-of-state verbs like 열리다, 앉다, 걸리다 take -아/어 있다."
      }
    ],
    "ex": {
      "a": "동생이 지금 밥을 먹고 있어요.",
      "b": "문이 열려 있어요."
    },
    "quiz": [
      {
        "q": "문이 ___ 있어요. (열리다)",
        "ok": "열려",
        "ans": "b",
        "why": "문이 열린 뒤 그대로인 상태라서 「-아/어 있다」예요."
      },
      {
        "q": "동생이 지금 밥을 ___ 있어요. (먹다)",
        "ok": "먹고",
        "ans": "a",
        "why": "밥을 먹는 동작이 이어지는 중이라 「-고 있다」예요."
      },
      {
        "q": "벽에 그림이 ___ 있어요. (걸리다)",
        "ok": "걸려",
        "ans": "b",
        "why": "걸린 뒤 그대로인 상태라서 「-아/어 있다」예요."
      },
      {
        "q": "지금 친구를 ___ 있어요. (기다리다)",
        "ok": "기다리고",
        "ans": "a",
        "why": "기다리는 동작을 하는 중이라 「-고 있다」예요."
      },
      {
        "q": "의자에 ___ 있어요. (앉다)",
        "ok": "앉아",
        "ans": "b",
        "why": "앉은 뒤 그대로인 상태라서 「앉아 있어요」예요."
      }
    ]
  }
